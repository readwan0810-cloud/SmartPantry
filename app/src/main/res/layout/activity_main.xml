<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Navigation toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/mainToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:title="Smart Pantry"
        android:titleTextColor="@android:color/white"
        android:layout_marginBottom="24dp" />

    <!-- Add pantry item -->
    <Button
        android:id="@+id/btnAddItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add item to pantry"
        android:layout_marginBottom="12dp" />

    <!-- View pantry items -->
    <Button
        android:id="@+id/btnViewItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View items in pantry"
        android:layout_marginBottom="12dp" />

    <!-- Check expiry dates -->
    <Button
        android:id="@+id/btnExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Check pantry items expiry date"
        android:layout_marginBottom="12dp" />

    <!-- Suggested recipes -->
    <Button
        android:id="@+id/btnSuggestedRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Available recipes"
        android:layout_marginBottom="12dp" />

    <!-- Settings -->
    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings" />

</LinearLayout>